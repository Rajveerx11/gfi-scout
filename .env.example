# Optional. Without a token you run unauthenticated at 60 requests/hour;
# a classic PAT with public_repo scope (read-only) raises that to 5,000/hour.
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
CACHE_TTL_MINUTES=30
# Optional. Set to sqlite to persist cache entries across process restarts.
CACHE_BACKEND=memory
LOG_LEVEL=info
MAX_CONCURRENT_REQUESTS=5
